# Copy to .env for local use. Never commit the real file.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://your-https-tunnel-or-domain.example   # Yahoo requires https
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Database: leave both unset for a local SQLite file, or choose one:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATABASE_PATH=league_hub.db
